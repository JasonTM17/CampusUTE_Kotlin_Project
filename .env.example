# CampusUTE — environment template. Copy to .env and fill locally.
# NEVER commit .env — CI scans for real secrets on every push.

# --- Host ports (override when your machine already runs these services) ---
POSTGRES_PORT=5432
REDIS_PORT=16379
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# --- PostgreSQL (core) ---
POSTGRES_USER=campusute
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=campusute
DATABASE_URL=postgresql://campusute:change_me_locally@localhost:5432/campusute

# --- Redis (core) ---
REDIS_URL=redis://localhost:16379/0

# --- Object storage (core, MinIO local dev) ---
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_locally

# --- Security ---
JWT_SECRET=change_me_locally_min_32_chars_long_value
APP_DEMO_MODE=true

# --- AI service (optional; empty key => mock/replay mode) ---
OPENAI_API_KEY=
AI_MODEL_CHAT=gpt-4.1-mini
AI_MODEL_ROUTER=gpt-4.1-nano
AI_MODEL_EMBEDDING=text-embedding-3-small

# --- Internal service auth (Phase 1+) ---
AI_SERVICE_TOKEN=
# Required by docker-compose.yml: both containers must agree on it and an unset
# value must fail loudly rather than fall back to a token committed in a file.
AI_INGEST_TOKEN=change_me_locally

# --- AI chat throttling (backend, per student per minute) ---
AI_CHAT_RATE_LIMIT=12

# --- Design tooling: Google Stitch MCP (optional) ---
# Optional per-project override. The preferred store is a Windows user
# environment variable, which applies to every project:
#   [Environment]::SetEnvironmentVariable('STITCH_API_KEY','<key>','User')
# scripts/mcp/stitch-mcp-launcher.mjs reads the user store when this file has no
# value. Never put the key in .zcode/config.json.
STITCH_API_KEY=
# Optional: pin generated designs to one Stitch project instead of the git-repo default.
STITCH_PROJECT_ID=
